# Copy to .env and fill in. .env is gitignored.

# ---------------------------------------------------------------------------
# Telegram bots
# ---------------------------------------------------------------------------
# priceWatch can route different rules to different bots. Each bot is a token.
# Bare-minimum: define ONE bot token + ONE chat_id below, then reference them
# from pricewatch/config.yaml using ${VAR} syntax.

# Generic priceWatch-dedicated bot (recommended for clean separation):
#   Create via @BotFather, get chat_id via @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Or reuse the matrixApps "notify" bot (token lives on the Win11 server — leave
# blank until you copy it back). Same chat_id can be reused.
FIREUP_NOTIFY_BOT_TOKEN=

# ---------------------------------------------------------------------------
# NLU intent parser ("monitor this URL when price < $100")
# ---------------------------------------------------------------------------
# Backend: ollama | anthropic | openai
PRICEWATCH_NLU_BACKEND=ollama

# Ollama (local). Default endpoint and model are usually fine.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.6:35b

# Anthropic / OpenAI (only needed if PRICEWATCH_NLU_BACKEND points there)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# HTTP IPC (for matrixApps / external integrations to push commands in)
# ---------------------------------------------------------------------------
PRICEWATCH_IPC_HOST=127.0.0.1
PRICEWATCH_IPC_PORT=8765
# Any non-empty value enables auth; clients must send `Authorization: Bearer <token>`
PRICEWATCH_IPC_TOKEN=

# ---------------------------------------------------------------------------
# Storage / runtime
# ---------------------------------------------------------------------------
PRICEWATCH_DB_PATH=data/pricewatch.db
PRICEWATCH_LOG_LEVEL=INFO
PRICEWATCH_USER_AGENT=Mozilla/5.0 (Macintosh; Intel Mac OS X 14_6) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.6 Safari/605.1.15
