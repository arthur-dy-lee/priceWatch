# Copy to .env and fill in. .env is gitignored.

# --- Telegram notifier ---
# Create a bot via @BotFather, then get your chat_id by talking to @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Storage ---
# Path is relative to project root. SQLite single-file db.
PRICEWATCH_DB_PATH=data/pricewatch.db

# --- Runtime ---
# DEBUG | INFO | WARNING | ERROR
PRICEWATCH_LOG_LEVEL=INFO

# Default User-Agent for httpx scrapers
PRICEWATCH_USER_AGENT=Mozilla/5.0 (Macintosh; Intel Mac OS X 14_6) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.6 Safari/605.1.15
